NEXT_PUBLIC_SITE_URL=https://syntaxai-web.vercel.app
NEXT_PUBLIC_CHROME_STORE_URL=https://chromewebstore.google.com/detail/syntaxai
NEXT_PUBLIC_HERO_VIDEO_URL=

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://syntaxai-web.vercel.app

# Neon Postgres
DATABASE_URL=
# Google OAuth (Web application)
# Authorized JavaScript origins: http://localhost:3000, https://syntaxai-web.vercel.app
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://syntaxai-web.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (Settings → Developer settings → OAuth Apps)
# Homepage URL: https://syntaxai-web.vercel.app
# Callback URL:
#   http://localhost:3000/api/auth/callback/github
#   https://syntaxai-web.vercel.app/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Polar.sh — organization access token + Pro product
# Sandbox: POLAR_SERVER=sandbox and sandbox token/product/webhook secret
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID=
POLAR_SERVER=production
