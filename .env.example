# Canonical production URL (Cloudflare → Vercel UI)
NEXT_PUBLIC_SITE_URL=https://syntaxai.app
NEXT_PUBLIC_CHROME_STORE_URL=https://chromewebstore.google.com/detail/syntaxai/fbkbpcidobeacdbhhinjgbdecnnadejm
NEXT_PUBLIC_FIREFOX_ADDON_URL=https://addons.mozilla.org/en-US/firefox/addon/syntaxai/
NEXT_PUBLIC_BOOK_CALL_URL=https://calendly.com/kiricenkooleg123/30min
NEXT_PUBLIC_SOCIAL_DISCORD_URL=
NEXT_PUBLIC_SOCIAL_TWITTER_URL=
NEXT_PUBLIC_SOCIAL_LINKEDIN_URL=
NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=
NEXT_PUBLIC_SOCIAL_TIKTOK_URL=
NEXT_PUBLIC_HERO_VIDEO_URL=

# Extension / heavy API host (Railway). Omit locally to use SITE_URL.
NEXT_PUBLIC_API_URL=https://api.syntaxai.app

# Vercel only: proxy browser /api/v1 + /api/me to Railway (extension should still use NEXT_PUBLIC_API_URL directly)
RAILWAY_API_ORIGIN=https://api.syntaxai.app

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Must match NEXT_PUBLIC_SITE_URL in production (cookie/auth on the marketing host)
BETTER_AUTH_URL=https://syntaxai.app

# Neon Postgres
DATABASE_URL=
# Google OAuth (Web application)
# Authorized JavaScript origins: http://localhost:3000, https://syntaxai.app
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://syntaxai.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (Settings → Developer settings → OAuth Apps)
# Homepage URL: https://syntaxai.app
# Callback URL:
#   http://localhost:3000/api/auth/callback/github
#   https://syntaxai.app/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Polar.sh — organization access token + Pro product
# Webhook: https://syntaxai.app/api/auth/polar/webhooks
# Sandbox: POLAR_SERVER=sandbox and sandbox token/product/webhook secret
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID=
POLAR_SERVER=production

# Beta: keep false until FOP + Polar checkout is live
NEXT_PUBLIC_BILLING_ENABLED=false

# OpenAI — server-only. Used by /api/v1/ai/* for the extension. Never expose as NEXT_PUBLIC_*.
OPENAI_API_KEY=

# Resend — server-only. Feedback / bug reports from the extension → hello@syntaxai.app
RESEND_API_KEY=
# Verified sender in Resend (fallback: onboarding@resend.dev for testing)
RESEND_FROM_EMAIL=SyntaxAI <hello@syntaxai.app>
FEEDBACK_TO_EMAIL=hello@syntaxai.app
